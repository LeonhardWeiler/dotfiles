STATE="${XDG_RUNTIME_DIR:-/tmp}/dictate"
PIDFILE="$STATE/pid"
STOPFILE="$STATE/stop"

mkdir -p "$STATE"

# Status display. Where the dwl machine drew a bar for as long as the recording
# ran, this is a Plasma notification that gets closed again when the step is
# over, so the indicator never piles up in the notification history.
NOTIFY_ID=

notify_close() {
  [ -n "$NOTIFY_ID" ] || return 0
  gdbus call --session \
    --dest org.freedesktop.Notifications \
    --object-path /org/freedesktop/Notifications \
    --method org.freedesktop.Notifications.CloseNotification "$NOTIFY_ID" \
    >/dev/null 2>&1
  NOTIFY_ID=
}

cleanup() {
  rm -f "$STOPFILE"

  [ -n "$REC_PID" ] && kill "$REC_PID" 2>/dev/null
  notify_close

  rm -rf "$STATE"
  [ -n "$TMP" ] && rm -f "$TMP" "$TMP.txt"

  exit 0
}

# zweiter Keybind -> Aufnahme beenden
if [ -f "$PIDFILE" ]; then
  PID=$(cat "$PIDFILE")

  if kill -0 "$PID" 2>/dev/null; then
    touch "$STOPFILE"
    exit 0
  fi

  rm -f "$PIDFILE"
fi

echo $$ > "$PIDFILE"
rm -f "$STOPFILE"

trap cleanup INT TERM HUP

TMP=$(mktemp --suffix=.wav)

NOTIFY_ID=$(notify-send -p -t 0 -i audio-input-microphone \
  "Aufnahme läuft" "Tastenkürzel nochmal drücken zum Beenden" 2>/dev/null)

echo "🎤 Aufnahme..."

pw-record "$TMP" >/dev/null 2>&1 &
REC_PID=$!

# warten auf zweiten Keybind
while [ ! -f "$STOPFILE" ]; do
  sleep 0.1
done

echo "⏹ Aufnahme beendet"

kill "$REC_PID" 2>/dev/null
wait "$REC_PID" 2>/dev/null

notify_close
NOTIFY_ID=$(notify-send -p -t 0 -i media-record \
  "Transkription läuft" "whisper.cpp" 2>/dev/null)

echo "⌛ Whisper..."

whisper-cli \
-m ~/files/models/ggml-medium-q5_0.bin \
-f "$TMP" \
-l de \
--no-timestamps \
-otxt \
-of "$TMP" \
>/dev/null 2>&1

if [ -s "$TMP.txt" ]; then
  tr '\n' ' ' < "$TMP.txt" \
    | sed 's/[[:space:]]\+/ /g;s/^ *//;s/ *$//' \
    | tr -d '\n' \
    | wl-copy

  notify_close
  notify-send -t 2000 -i edit-paste "Diktat im Clipboard" 2>/dev/null
  echo "✓ Im Clipboard"
fi

cleanup

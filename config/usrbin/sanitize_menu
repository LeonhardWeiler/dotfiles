#
# rofi front-end for `sanitize`: one window that filters the files below $HOME
# as you type, and hands the pick to `sanitize`.  The original is never touched
# - the copy lands in a tmpfs directory that disappears with the session.
#
# Two ways to paste, because "share a file" means two different things:
#
#   Return        the image itself, so Ctrl+V drops it into Signal, a mail or
#                 a browser text field.  Only images can go this way; anything
#                 else falls back to the path.
#   Shift+Return  the path of the cleaned copy as plain text, for the "upload
#                 a file" dialogs (Ctrl+L, then Ctrl+V).
#
# The candidate list is built once and piped into rofi, which then does the
# filtering in-process - that is what makes it live.  For that to stay snappy
# the list has to stay small, so only files that carry metadata in the first
# place are offered (EXT_RE).  That is not an arbitrary cut: it is very nearly
# the set `sanitize` can process, so what it drops would have errored out on
# Return anyway.  Here it takes the candidates from 278k files down to 19k.
#
# Hidden directories are skipped: ~/.cache, ~/.mozilla and the rest hold no
# file anyone means to send, and they would bury the real hits.

set -u

SELF=${0##*/}

# Matched against the whole "<mtime>\t<path>" line, hence anchored at the end.
EXT_RE='\.(jpe?g|png|gif|webp|avif|tiff?|heic|heif|bmp|svg|mp4|mkv|mov|webm|avi|m4v|mp3|flac|ogg|opus|m4a|wav|aac|pdf|docx|odt|xlsx|ods|pptx|odp|epub|zip|tar|gz)$'

usage() {
  cat <<EOF
Usage: $SELF

rofi menu that copies a metadata-free version of a file below \$HOME:
type to filter, Return copies the image, Shift+Return the path.

  -h, --help  show this help
EOF
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  "")        ;;
  *)         usage >&2; exit 1 ;;
esac

for cmd in rofi find file wl-copy; do
  command -v "$cmd" >/dev/null 2>&1 || {
    echo "$SELF: '$cmd' not found" >&2
    exit 1
  }
done

# Taken from next to this script rather than from PATH: dwl spawns us with
# whatever environment the session started with.
SANITIZE=$(dirname -- "$0")/sanitize
[ -x "$SANITIZE" ] || {
  echo "$SELF: '$SANITIZE' not found" >&2
  exit 1
}

message() { rofi -e "$1"; }

# ── search and pick, in one window ──────────────────────────────────────────

# Newest first: the file worth sending is usually the one just created.  The
# sort has to buffer the whole list, so rofi's window comes up empty for a
# moment - which is fine, nobody has finished typing by then.
#
# No -p: the prompt would sit next to the input, and the theme's "Search..."
# placeholder already says what the field is (same look as MOD+I).
CHOICE=$(find "$HOME" \( -name '.*' -o -name node_modules \) -prune -o \
              -type f -printf '%T@\t%p\n' 2>/dev/null |
         grep -Ei "$EXT_RE" |
         sort -rn | cut -f2- | sed "s|^$HOME/|~/|" |
         rofi -dmenu -i -no-custom \
              -mesg 'Return: copy the image   ·   Shift+Return: copy the path')
RC=$?

case $RC in
  0)  MODE=content ;;
  10) MODE=path ;;      # Shift+Return, rofi's alternate accept
  *)  exit 0 ;;         # cancelled
esac

[ -n "$CHOICE" ] || exit 0
case $CHOICE in
  '~/'*) FILE=$HOME/${CHOICE#'~/'} ;;
  *)     FILE=$CHOICE ;;
esac

# ── strip and copy ──────────────────────────────────────────────────────────

CLEAN=$("$SANITIZE" -q -- "$FILE") || {
  message "Could not strip metadata from
$CHOICE

Unsupported format - send it only if you know what is inside."
  exit 1
}

MIME=$(file --mime-type -b -- "$CLEAN" 2>/dev/null)

# wl-copy offers exactly one MIME type per invocation, so pasting the picture
# and pasting its path are mutually exclusive - hence the two keys.
case $MODE:$MIME in
  content:image/*)
    wl-copy --type "$MIME" <"$CLEAN" || exit 1
    message "Cleaned image on the clipboard, ready to paste.

$CLEAN"
    ;;
  content:*)
    wl-copy -- "$CLEAN" || exit 1
    message "$MIME cannot be pasted as content, so the path was copied instead.

$CLEAN"
    ;;
  *)
    wl-copy -- "$CLEAN" || exit 1
    message "Path of the cleaned copy on the clipboard.

$CLEAN"
    ;;
esac

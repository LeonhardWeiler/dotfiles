#
# rofi front-end for removable drives: mount, unmount and eject. Plain
# mount(8)/umount(8) through the passwordless sudo this system already grants
# `wheel` (the `--sudoers` step) - no udisks2, no daemon, no fstab entries.
#
# The menu lists one line per action, with the action as the first word, so the
# whole thing stays searchable by typing "mount", "eject" or a drive label.

ALL=0
SELF=${0##*/}

# Where drives are mounted. /run is a tmpfs, so a mount point left behind by a
# crash disappears on the next boot.
MOUNT_ROOT=/run/media/$(id -un)

usage() {
  cat <<EOF
Usage: $SELF [-a|--all]

rofi menu for mounting/unmounting drives, mounted under $MOUNT_ROOT.

  -a, --all   also list internal (non-removable) filesystems
  -h, --help  show this help
EOF
}

case "${1:-}" in
  -a|--all)  ALL=1 ;;
  -h|--help) usage; exit 0 ;;
  "")        ;;
  *)         usage >&2; exit 1 ;;
esac

for cmd in rofi lsblk findmnt sudo; do
  command -v "$cmd" >/dev/null 2>&1 || {
    echo "$SELF: '$cmd' not found" >&2
    exit 1
  }
done

# lsblk's raw output escapes spaces inside values as \x20, so a plain space is
# safe as a field separator - but only a non-whitespace IFS keeps empty fields
# (an unlabelled partition) as empty fields, hence the swap to FS (0x1c).
FS=$(printf '\034')

# The rofi theme hides the prompt (inputbar shows only the entry); this menu
# needs it, so it is switched back on per invocation instead of in config.rasi.
SHOW_PROMPT='inputbar { children: [ "prompt", "entry" ]; }'

plain() { printf '%s' "$1" | sed 's/\\x20/ /g'; }

menu()    { rofi -dmenu -i -no-custom -p "$1" -theme-str "$SHOW_PROMPT"; }
message() { rofi -e "$1"; }

# Every privileged call is non-interactive: there is no terminal to type a
# password into, so a missing sudo rule has to fail instead of hang.
root() { sudo -n "$@"; }

# ── device inspection ───────────────────────────────────────────────────────

# A mountpoint outside the removable-media directories belongs to the system
# (/, /home, [SWAP], …) and is never offered for unmounting.
ours() {
  case "$1" in
    /run/media/*|/media/*|/mnt/*) return 0 ;;
    *)                            return 1 ;;
  esac
}

model() {
  [ -n "$1" ] || return 0
  plain "$(lsblk -rdno MODEL "$1" 2>/dev/null)"
}

# ── menu ────────────────────────────────────────────────────────────────────

build_menu() {
  lsblk -rpno NAME,TYPE,SIZE,FSTYPE,LABEL,MOUNTPOINT,HOTPLUG,PKNAME |
    tr ' ' "$FS" |
    while IFS="$FS" read -r name type size fstype label mnt hotplug pkname; do
      case "$type" in
        part|disk|rom|loop)
          [ "$ALL" = 1 ] || [ "$hotplug" = 1 ] || continue ;;
        *) continue ;;
      esac

      # Already mounted somewhere the system owns → hands off entirely.
      if [ -n "$mnt" ] && ! ours "$mnt"; then
        continue
      fi

      desc=$(plain "$label")
      [ -n "$desc" ] || desc=$(model "${pkname:-$name}")
      [ -n "$desc" ] || desc="-"

      case "$fstype" in
        ""|swap|crypto_LUKS|LVM2_member|linux_raid_member|zfs_member)
          : ;;   # nothing this script can mount
        *)
          if [ -n "$mnt" ]; then
            printf '%-8s %-14s %8s  %-11s %s  ->  %s\n' \
              unmount "$name" "$size" "$fstype" "$desc" "$(plain "$mnt")"
          else
            printf '%-8s %-14s %8s  %-11s %s\n' \
              mount "$name" "$size" "$fstype" "$desc"
          fi
          ;;
      esac

      # One eject line per removable disk - it unmounts everything still open
      # on the drive and powers it down, so a stick needs a single pick before
      # it is safe to pull out.
      if [ "$type" = disk ] && [ "$hotplug" = 1 ]; then
        printf '%-8s %-14s %8s  %-11s %s\n' \
          eject "$name" "$size" drive "$(model "$name")"
      fi
    done
}

# ── actions ─────────────────────────────────────────────────────────────────

# Mount points are named after the label, reduced to characters that need no
# quoting; an unlabelled partition falls back to its device name.
mount_point_for() {
  name=$(plain "$2" | tr -c 'A-Za-z0-9._-' '_')
  case "$name" in
    ""|.|..|_*) name=${1##*/} ;;
  esac
  point=$MOUNT_ROOT/$name
  # A second drive carrying the same label must not land on the first one.
  if findmnt -no TARGET --mountpoint "$point" >/dev/null 2>&1; then
    point=$point-${1##*/}
  fi
  printf '%s' "$point"
}

mount_device() {
  dev=$1
  fstype=$(lsblk -rdno FSTYPE "$dev")
  point=$(mount_point_for "$dev" "$(lsblk -rdno LABEL "$dev")")

  # Removable media is never trusted with device nodes or setuid bits. The
  # Windows filesystems carry no ownership of their own, so the mount has to
  # hand them to the user; a Linux filesystem brings its own permissions.
  opts=nosuid,nodev,noatime
  case "$fstype" in
    vfat|exfat|ntfs|ntfs3|msdos)
      opts="$opts,uid=$(id -u),gid=$(id -g),umask=022" ;;
  esac

  out=$(root mkdir -p "$point" 2>&1) || { message "$out"; exit 1; }
  out=$(root mount -o "$opts" "$dev" "$point" 2>&1) || {
    root rmdir "$point" 2>/dev/null
    message "$out"
    exit 1
  }
  # Reported through a variable rather than stdout: a command substitution
  # would put the whole function in a subshell, where its `exit` on failure
  # could not stop the caller.
  MOUNTED_AT=$point
}

# Unmounts and cleans up our own mount point; the caller reports the outcome.
try_unmount() {
  point=$(findmnt -no TARGET "$1" | head -n1)
  out=$(root umount "$1" 2>&1) || return 1
  case "$point" in
    "$MOUNT_ROOT"/*) root rmdir "$point" 2>/dev/null ;;
  esac
  return 0
}

eject_disk() {
  for part in $(lsblk -rpno NAME,MOUNTPOINT "$1" |
                  awk 'NF >= 2 && $2 != "[SWAP]" { print $1 }'); do
    try_unmount "$part" || { message "$out"; exit 1; }
  done
  sync

  # Telling the kernel to delete the block device is what makes the drive spin
  # down and stop responding, i.e. what "safe removal" buys over a bare
  # unmount. Not every bus offers it (SD cards, NVMe) - unmounted plus synced
  # is already safe there.
  delete=/sys/block/${1##*/}/device/delete
  if [ -e "$delete" ]; then
    out=$(root sh -c "printf 1 > $delete" 2>&1) ||
      { message "Unmounted, but powering the drive down failed:
$out"; exit 1; }
  fi
  message "${1##*/} can be removed safely."
}

# ── main ────────────────────────────────────────────────────────────────────

entries=$(build_menu)
[ -n "$entries" ] || {
  if [ "$ALL" = 1 ]; then
    message "No mountable filesystems found."
  else
    message "No removable drives found.
Run '$SELF --all' to include internal filesystems."
  fi
  exit 0
}

choice=$(printf '%s\n' "$entries" | menu drive) || exit 0
[ -n "$choice" ] || exit 0

# Fields are shell-safe: the action is a literal word and a device path never
# contains whitespace.
# shellcheck disable=SC2086
set -- $choice
action=${1:-}
device=${2:-}
[ -n "$device" ] || exit 0

case "$action" in
  mount)   mount_device "$device"
           message "Mounted $device at $MOUNTED_AT" ;;
  unmount) try_unmount "$device" || { message "$out"; exit 1; }
           message "Unmounted $device" ;;
  eject)   eject_disk "$device" ;;
  *)       exit 1 ;;
esac

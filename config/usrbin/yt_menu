#
# rofi front-end for the two YouTube lists in the notes repo: type a name, hit
# Return, the video opens in a new browser tab. The other half of the same
# workflow lives in the browser - the `yt-save` extension and `yt_save` put the
# entries there in the first place.
#
# Both lists are in one window, prefixed, so "W " narrows it to the watchlist:
#
#   Return         open
#   Alt+BackSpace  take it off the list without opening
#
# Removing does not end the menu: it reopens with the shortened list and the
# text that was typed, so several entries can go in one pass.
#
# Removed lines are not deleted but moved to yt/watched.md with the date, so
# "already seen" stays answerable without digging through the git history.

set -uf

SELF=${0##*/}

NOTES=${YT_NOTES_DIR:-$HOME/files/repos/notes}
YT_DIR=$NOTES/yt
WATCHED=$YT_DIR/watched.md

BROWSER_CMD=${YT_BROWSER:-zen-browser}

TAB=$(printf '\t')

usage() {
  cat <<EOF
Usage: $SELF

rofi menu for the YouTube lists in $YT_DIR.

  Return         open the entry in a new browser tab
  Alt+BackSpace  move it to watched.md without opening

  -h, --help  show this help
EOF
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  "")        ;;
  *)         usage >&2; exit 1 ;;
esac

for cmd in rofi awk sed; do
  command -v "$cmd" >/dev/null 2>&1 || {
    echo "$SELF: '$cmd' not found" >&2
    exit 1
  }
done

message() { rofi -e "$1"; }

# Does the carried-over filter still match one of the rows? Approximates
# rofi's default matcher: every space-separated word has to be in the line,
# case-insensitively. Without this, removing the very entry that was searched
# for would reopen the menu on an empty list with a dead filter in the field.
filter_matches() {
  [ -n "$1" ] || return 0
  printf '%s\n' "$2" | awk -v pat="$1" '
    BEGIN { n = split(tolower(pat), word, / +/) }
    {
      line = tolower($0)
      for (i = 1; i <= n; i++) if (index(line, word[i]) == 0) next
      found = 1
      exit
    }
    END { exit !found }
  '
}

# ── index ───────────────────────────────────────────────────────────────────

# One record per entry: tag, line number, url, name. The line number is what
# makes removing an entry possible later; the name alone would not survive two
# videos sharing a title.
#
# Both spellings are read: the usual `- [name](url)` and the reversed
# `(name)[url]` that is already in remember.md.
index_of() {
  [ -f "$2" ] || return 0
  awk -v tag="$1" '
    {
      if (match($0, /\[[^]]*\]\([^)]*\)/)) {
        s = substr($0, RSTART, RLENGTH); p = index(s, "](")
      } else if (match($0, /\([^)]*\)\[[^]]*\]/)) {
        s = substr($0, RSTART, RLENGTH); p = index(s, ")[")
      } else next

      name = substr(s, 2, p - 2)
      url  = substr(s, p + 2, length(s) - p - 2)
      if (url !~ /^https?:\/\//) next

      gsub(/[\t\r]/, " ", name)
      gsub(/^ +| +$/, "", name)
      if (name == "") name = url

      print tag "\t" NR "\t" url "\t" name
    }
  ' "$2"
}

# ── act ─────────────────────────────────────────────────────────────────────

open_entry() {
  command -v "$BROWSER_CMD" >/dev/null 2>&1 || {
    message "'$BROWSER_CMD' not found."
    exit 1
  }
  "$BROWSER_CMD" --new-tab "$URL" >/dev/null 2>&1 &
}

commit() {
  git -C "$NOTES" rev-parse --git-dir >/dev/null 2>&1 || return 0
  for path in "$@"; do
    git -C "$NOTES" ls-files --error-unmatch -- "$path" >/dev/null 2>&1 ||
      git -C "$NOTES" add -- "$path" >/dev/null 2>&1
  done
  git -C "$NOTES" commit -q -m "[yt/${FILE##*/}] changed" -- "$@" >/dev/null 2>&1 ||
    echo "$SELF: commit failed" >&2
}

remove_entry() {
  # The index was built before rofi opened; an editor may have saved the file
  # in the meantime, and deleting by stale line number would take out the
  # wrong entry. The url has to still be on that line.
  line=$(sed -n "${LNO}p" "$FILE")
  case $line in
    *"$URL"*) ;;
    *) message "The list changed since the menu opened - nothing was removed.

Reopen it and try again."
       exit 1 ;;
  esac

  sed -i "${LNO}d" "$FILE" || {
    message "Could not write $FILE"
    exit 1
  }

  [ -s "$WATCHED" ] || printf '# watched\n\n' >"$WATCHED"
  printf -- '- %s [%s](%s) (%s)\n' "$(date +%F)" "$TITLE" "$URL" "$LIST" >>"$WATCHED"

  commit "yt/${FILE##*/}" "yt/${WATCHED##*/}"
}

# ── the menu ────────────────────────────────────────────────────────────────

# Removing an entry loops back into rofi instead of ending the run, so a
# handful of them can go without reopening the menu by hand. The list is built
# again every time round - the file changed, and so did every line number
# below the deleted one.
FILTER=

while :; do
  # The watchlist first: it is the list with something to do on it.
  INDEX=$(index_of W "$YT_DIR/watchlist.md"; index_of R "$YT_DIR/remember.md")

  [ -n "$INDEX" ] || {
    message "Nothing on the YouTube lists.

$YT_DIR"
    exit 0
  }

  # `-format 'i f'` hands back the row number rather than its text, so two
  # entries with the same name cannot be confused for one another, plus what
  # was typed into the field - that goes back in via -filter on the next round
  # so a removal does not throw the search away.
  #
  # No -p: the theme's "Search..." placeholder already says what the field is
  # (same look as MOD+I and MOD+S).
  ROWS=$(printf '%s\n' "$INDEX" | awk -F"$TAB" '{ printf "[%s] %s\n", $1, $4 }')
  filter_matches "$FILTER" "$ROWS" || FILTER=

  OUT=$(printf '%s\n' "$ROWS" |
        rofi -dmenu -i -no-custom -format 'i f' -filter "$FILTER" \
             -kb-custom-2 'Alt+BackSpace' \
             -mesg 'Return: open   ·   Alt+BackSpace: remove')
  RC=$?

  case $RC in
    0)  ACTION=open ;;
    11) ACTION=remove ;;  # kb-custom-2
    *)  exit 0 ;;         # cancelled
  esac

  # "<row> <filter>": the row number is everything up to the first space, the
  # filter is the rest and may hold spaces of its own.
  CHOICE=${OUT%% *}
  case $OUT in
    *' '*) FILTER=${OUT#* } ;;
    *)     FILTER= ;;
  esac

  # The row number is a number and nothing else; anything but that means we are
  # not talking to the rofi we think we are, and no line may be deleted on the
  # strength of it.
  case ${CHOICE:-} in
    ""|*[!0-9]*) exit 0 ;;
  esac

  ROW=$(printf '%s\n' "$INDEX" | sed -n "$((CHOICE + 1))p")
  [ -n "$ROW" ] || exit 0

  IFS=$TAB read -r TAG LNO URL TITLE <<EOF
$ROW
EOF

  case $TAG in
    W) FILE=$YT_DIR/watchlist.md; LIST=watchlist ;;
    *) FILE=$YT_DIR/remember.md;  LIST=remember ;;
  esac

  case $ACTION in
    open)   open_entry; exit 0 ;;
    remove) remove_entry ;;
  esac
done

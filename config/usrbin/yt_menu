#!/bin/sh
# SPDX-License-Identifier: ISC
# Copyright (C) 2026 The leonhardweiler/dotfiles Authors
#
# rofi front-end for the two YouTube lists in the notes repo: type a name, hit
# Return, the video opens in a new browser window. The other half of the same
# workflow lives in the browser - the `yt-save` extension and `yt_save` put the
# entries there in the first place.
#
# Both lists are in one window, prefixed, so "W " narrows it to the watchlist:
#
#   Return        open
#   Shift+Return  open and take the entry off the list
#   Alt+Delete    take it off the list without opening
#
# Removed lines are not deleted but moved to yt/watched.md with the date, so
# "already seen" stays answerable without digging through the git history.

set -uf

SELF=${0##*/}

NOTES=${YT_NOTES_DIR:-$HOME/files/repos/notes}
YT_DIR=$NOTES/yt
WATCHED=$YT_DIR/watched.md

BROWSER_CMD=${YT_BROWSER:-zen-browser}

TAB=$(printf '\t')

usage() {
  cat <<EOF
Usage: $SELF

rofi menu for the YouTube lists in $YT_DIR.

  Return        open the entry
  Shift+Return  open it and move it to watched.md
  Alt+Delete    move it to watched.md without opening

  -h, --help  show this help
EOF
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  "")        ;;
  *)         usage >&2; exit 1 ;;
esac

for cmd in rofi awk sed; do
  command -v "$cmd" >/dev/null 2>&1 || {
    echo "$SELF: '$cmd' not found" >&2
    exit 1
  }
done

message() { rofi -e "$1"; }

# ── index ───────────────────────────────────────────────────────────────────

# One record per entry: tag, line number, url, name. The line number is what
# makes removing an entry possible later; the name alone would not survive two
# videos sharing a title.
#
# Both spellings are read: the usual `- [name](url)` and the reversed
# `(name)[url]` that is already in remember.md.
index_of() {
  [ -f "$2" ] || return 0
  awk -v tag="$1" '
    {
      if (match($0, /\[[^]]*\]\([^)]*\)/)) {
        s = substr($0, RSTART, RLENGTH); p = index(s, "](")
      } else if (match($0, /\([^)]*\)\[[^]]*\]/)) {
        s = substr($0, RSTART, RLENGTH); p = index(s, ")[")
      } else next

      name = substr(s, 2, p - 2)
      url  = substr(s, p + 2, length(s) - p - 2)
      if (url !~ /^https?:\/\//) next

      gsub(/[\t\r]/, " ", name)
      gsub(/^ +| +$/, "", name)
      if (name == "") name = url

      print tag "\t" NR "\t" url "\t" name
    }
  ' "$2"
}

# The watchlist first: it is the list with something to do on it.
INDEX=$(index_of W "$YT_DIR/watchlist.md"; index_of R "$YT_DIR/remember.md")

[ -n "$INDEX" ] || {
  message "Nothing on the YouTube lists.

$YT_DIR"
  exit 0
}

# ── pick ────────────────────────────────────────────────────────────────────

# `-format i` hands back the row number rather than its text, so two entries
# with the same name cannot be confused for one another.
#
# No -p: the theme's "Search..." placeholder already says what the field is
# (same look as MOD+I and MOD+S).
CHOICE=$(printf '%s\n' "$INDEX" |
         awk -F"$TAB" '{ printf "[%s] %s\n", $1, $4 }' |
         rofi -dmenu -i -no-custom -format i \
              -kb-custom-2 'Alt+Delete' \
              -mesg 'Return: open   ·   Shift+Return: open + remove   ·   Alt+Delete: remove')
RC=$?

case $RC in
  0)  ACTION=open ;;
  10) ACTION=both ;;    # Shift+Return, rofi's alternate accept
  11) ACTION=remove ;;  # kb-custom-2
  *)  exit 0 ;;         # cancelled
esac

# `-format i` yields a row number and nothing else; anything but that means we
# are not talking to the rofi we think we are, and no line may be deleted on
# the strength of it.
case ${CHOICE:-} in
  ""|*[!0-9]*) exit 0 ;;
esac

ROW=$(printf '%s\n' "$INDEX" | sed -n "$((CHOICE + 1))p")
[ -n "$ROW" ] || exit 0

IFS=$TAB read -r TAG LNO URL TITLE <<EOF
$ROW
EOF

case $TAG in
  W) FILE=$YT_DIR/watchlist.md; LIST=watchlist ;;
  *) FILE=$YT_DIR/remember.md;  LIST=remember ;;
esac

# ── act ─────────────────────────────────────────────────────────────────────

open_entry() {
  command -v "$BROWSER_CMD" >/dev/null 2>&1 || {
    message "'$BROWSER_CMD' not found."
    exit 1
  }
  "$BROWSER_CMD" --new-window "$URL" >/dev/null 2>&1 &
}

commit() {
  git -C "$NOTES" rev-parse --git-dir >/dev/null 2>&1 || return 0
  for path in "$@"; do
    git -C "$NOTES" ls-files --error-unmatch -- "$path" >/dev/null 2>&1 ||
      git -C "$NOTES" add -- "$path" >/dev/null 2>&1
  done
  git -C "$NOTES" commit -q -m "[yt/${FILE##*/}] changed" -- "$@" >/dev/null 2>&1 ||
    echo "$SELF: commit failed" >&2
}

remove_entry() {
  # The index was built before rofi opened; an editor may have saved the file
  # in the meantime, and deleting by stale line number would take out the
  # wrong entry. The url has to still be on that line.
  line=$(sed -n "${LNO}p" "$FILE")
  case $line in
    *"$URL"*) ;;
    *) message "The list changed since the menu opened - nothing was removed.

Reopen it and try again."
       exit 1 ;;
  esac

  sed -i "${LNO}d" "$FILE" || {
    message "Could not write $FILE"
    exit 1
  }

  [ -s "$WATCHED" ] || printf '# watched\n\n' >"$WATCHED"
  printf -- '- %s [%s](%s) (%s)\n' "$(date +%F)" "$TITLE" "$URL" "$LIST" >>"$WATCHED"

  commit "yt/${FILE##*/}" "yt/${WATCHED##*/}"
}

case $ACTION in
  open)   open_entry ;;
  both)   open_entry; remove_entry ;;
  remove) remove_entry ;;
esac

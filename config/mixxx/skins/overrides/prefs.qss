/* SPDX-License-Identifier: ISC
 * Copyright (C) 2026 The leonhardweiler/dotfiles Authors
 *
 * Qt style sheet for Mixxx' own dialogs, generated by build-skin into
 * $MIXXX_SETTINGS_DIR/prefs.qss and handed to Mixxx as `-stylesheet`.
 * Placeholders of the form at-name-at are filled from palette.conf.
 *
 * Why this is a separate file and not part of the skin: a skin only styles
 * the main window. Preferences, the track properties dialog and every message
 * box are plain QDialogs created in Mixxx' own code, outside the skin's
 * widget tree, and they come up in whatever the Qt platform theme says -
 * which for this setup is nothing at all, because qt5ct does not apply to a
 * Qt6 build. `-stylesheet` is the one lever that reaches them without
 * repainting every other Qt app on the system.
 *
 * Everything is rooted at `QDialog` on purpose. Qt merges the application
 * style sheet with the one an ancestor widget carries and lets the closer
 * one win, so the skin already outranks this file inside the main window -
 * but only for properties the skin actually sets. Scoping to dialogs means
 * the question never comes up.
 *
 * The colors are the skin's, not a second dark theme: same background as the
 * library, the same 1px border, and rofi's accent for focus - the same three
 * decisions overrides/style.qss makes for the search field.
 */

/* --- Base ----------------------------------------------------------------
 * `QDialog QWidget` is deliberately broad: the preference pages are plain
 * QWidgets inside a QStackedWidget and have no class of their own to target.
 * Everything below is written at the same specificity and wins on source
 * order. */

QDialog,
QDialog QWidget {
  background-color: @bg@;
  color: @fg@;
  /* Named on every widget, not only on the dialog: Qt hands a stylesheet
   * font down to children only where the child has not had a font set for
   * it already, and the widget style sets one on buttons. */
  font-family: "@font_family@";
}

QDialog QLabel,
QDialog QCheckBox,
QDialog QRadioButton,
QDialog QGroupBox {
  background-color: transparent;
  color: @fg@;
}

QDialog QLabel:disabled,
QDialog QCheckBox:disabled,
QDialog QRadioButton:disabled {
  color: #666666;
}

/* Mixxx marks its inline help links with the default link color, which is a
 * bright blue nothing else here uses. */
QDialog QLabel a {
  color: @accent@;
}

/* --- Grouping ------------------------------------------------------------
 * A group box is a labelled region, so it gets the same treatment the skin
 * gives its own regions: a hairline, no fill, the title sitting in the line. */

QDialog QGroupBox {
  border: 1px solid #333333;
  border-radius: 0px;
  margin-top: 0.7em;
  padding: 0.6em 0.4em 0.4em 0.4em;
}
  QDialog QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 0.6em;
    padding: 0px 0.3em;
    color: @dim@;
  }

QDialog QFrame[frameShape="4"],  /* HLine */
QDialog QFrame[frameShape="5"] { /* VLine */
  background-color: #333333;
  border: none;
}

/* --- Text and number entry ----------------------------------------------- */

QDialog QLineEdit,
QDialog QPlainTextEdit,
QDialog QTextEdit,
QDialog QSpinBox,
QDialog QDoubleSpinBox,
QDialog QTimeEdit {
  background-color: #1a1a1a;
  color: @fg@;
  border: 1px solid @border@;
  border-radius: 0px;
  padding: 2px 4px;
  selection-background-color: @surface@;
  selection-color: @fg@;
}

QDialog QLineEdit:focus,
QDialog QPlainTextEdit:focus,
QDialog QTextEdit:focus,
QDialog QSpinBox:focus,
QDialog QDoubleSpinBox:focus,
QDialog QTimeEdit:focus {
  border: 1px solid @accent@;
}

QDialog QLineEdit:disabled,
QDialog QSpinBox:disabled,
QDialog QDoubleSpinBox:disabled {
  background-color: #161616;
  color: #666666;
  border: 1px solid #333333;
}

QDialog QSpinBox::up-button,
QDialog QDoubleSpinBox::up-button,
QDialog QTimeEdit::up-button,
QDialog QSpinBox::down-button,
QDialog QDoubleSpinBox::down-button,
QDialog QTimeEdit::down-button {
  background-color: @surface@;
  border: 0px;
  width: 14px;
}
  QDialog QSpinBox::up-button:hover,
  QDialog QDoubleSpinBox::up-button:hover,
  QDialog QSpinBox::down-button:hover,
  QDialog QDoubleSpinBox::down-button:hover {
    background-color: #3a3a3a;
  }
  /* The library's sort triangles. They are wider than they are tall, so the
   * size has to be named - left to scale into the button they meet in the
   * middle and read as one diamond. */
  QDialog QSpinBox::up-arrow,
  QDialog QDoubleSpinBox::up-arrow,
  QDialog QTimeEdit::up-arrow,
  QDialog QSpinBox::down-arrow,
  QDialog QDoubleSpinBox::down-arrow,
  QDialog QTimeEdit::down-arrow {
    width: 7px;
    height: 5px;
  }
  QDialog QSpinBox::up-arrow,
  QDialog QDoubleSpinBox::up-arrow,
  QDialog QTimeEdit::up-arrow {
    image: url(@skin@/palemoon/buttons/btn__lib_sort_up.svg);
  }
  QDialog QSpinBox::down-arrow,
  QDialog QDoubleSpinBox::down-arrow,
  QDialog QTimeEdit::down-arrow {
    image: url(@skin@/palemoon/buttons/btn__lib_sort_down.svg);
  }

/* --- Buttons -------------------------------------------------------------
 * The skin's buttons are a flat surface that lifts on hover and sinks when
 * pressed; same three steps here, without the SVG bevel. */

QDialog QPushButton,
QDialog QToolButton {
  background-color: @surface@;
  color: @fg@;
  border: 1px solid @border@;
  border-radius: 0px;
  padding: 3px 12px;
  min-height: 1.2em;
}
  QDialog QPushButton:hover,
  QDialog QToolButton:hover {
    background-color: #3a3a3a;
  }
  QDialog QPushButton:pressed,
  QDialog QToolButton:pressed {
    background-color: #232323;
  }
  QDialog QPushButton:default {
    border: 1px solid @accent@;
  }
  QDialog QPushButton:focus,
  QDialog QToolButton:focus {
    border: 1px solid @border_focus@;
  }
  QDialog QPushButton:disabled,
  QDialog QToolButton:disabled {
    background-color: #1e1e1e;
    color: #666666;
    border: 1px solid #333333;
  }

/* --- Check boxes and radio buttons ---------------------------------------
 * Square for both. The skin has no round controls anywhere, and a checked
 * box is filled with the accent rather than carrying a tick glyph - at this
 * size a fill reads faster than a mark. */

QDialog QCheckBox::indicator,
QDialog QRadioButton::indicator {
  width: 0.8em;
  height: 0.8em;
  border: 1px solid @border@;
  border-radius: 0px;
  background-color: #1a1a1a;
}
  QDialog QCheckBox::indicator:checked,
  QDialog QRadioButton::indicator:checked {
    background-color: @accent@;
    border: 1px solid @accent@;
  }
  QDialog QCheckBox::indicator:indeterminate {
    background-color: @border@;
  }
  QDialog QCheckBox::indicator:hover,
  QDialog QRadioButton::indicator:hover {
    border: 1px solid @border_focus@;
  }
  QDialog QCheckBox::indicator:disabled,
  QDialog QRadioButton::indicator:disabled {
    border: 1px solid #333333;
    background-color: #161616;
  }

/* --- Combo boxes ---------------------------------------------------------- */

QDialog QComboBox {
  background-color: #1a1a1a;
  color: @fg@;
  border: 1px solid @border@;
  border-radius: 0px;
  padding: 2px 4px;
  min-height: 1.2em;
}
  QDialog QComboBox:hover {
    border: 1px solid @border_focus@;
  }
  QDialog QComboBox:focus,
  QDialog QComboBox:on {
    border: 1px solid @accent@;
  }
  QDialog QComboBox:disabled {
    background-color: #161616;
    color: #666666;
    border: 1px solid #333333;
  }
  QDialog QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 16px;
    border: 0px;
    background: transparent;
  }
  /* The library's sort triangle, not the effect rack's selector arrow: that
   * one is drawn small inside a 32x48 canvas and disappears when scaled into
   * an arrow-sized box. This asset fills its viewBox and survives. */
  QDialog QComboBox::down-arrow {
    image: url(@skin@/palemoon/buttons/btn__lib_sort_down.svg);
    width: 9px;
    height: 7px;
  }
  /* The popup is a top-level window and not a child of the dialog, so it is
   * addressed through the combo box it belongs to. */
  QDialog QComboBox QAbstractItemView {
    background-color: @bg@;
    color: @fg@;
    border: 1px solid @border@;
    selection-background-color: @surface@;
    selection-color: @fg@;
    outline: none;
  }

/* --- Lists, trees and tables ---------------------------------------------
 * The same surfaces the library uses: background from rofi, the alternating
 * row a lift rather than a dip, selection as a fill without a hue. */

QDialog QAbstractItemView,
QDialog QTreeView,
QDialog QListView,
QDialog QTableView,
QDialog QTreeWidget,
QDialog QListWidget,
QDialog QTableWidget {
  background-color: @bg@;
  alternate-background-color: #191919;
  color: @fg@;
  border: 1px solid #333333;
  border-radius: 0px;
  selection-background-color: @surface@;
  selection-color: @fg@;
  outline: none;
}
  QDialog QTreeView::item,
  QDialog QListView::item,
  QDialog QTableView::item {
    padding: 2px;
    border: 0px;
  }
  QDialog QTreeView::item:selected,
  QDialog QListView::item:selected,
  QDialog QTableView::item:selected {
    background-color: @surface@;
    color: @fg@;
  }
  QDialog QTreeView::item:hover,
  QDialog QListView::item:hover {
    background-color: #1f1f1f;
  }
  QDialog QTreeView::branch {
    background-color: @bg@;
  }
  QDialog QTreeView::branch:selected {
    background-color: @surface@;
  }

/* --- The preferences window ----------------------------------------------
 * Mixxx opens this at the width its pages ask for, and those pages were laid
 * out for a proportional font. A monospaced one needs roughly half again as
 * much room per line, so at the inherited width the value of every combo box
 * on the sound page is cut off and the page grows a horizontal scroll bar.
 * The type is the point of styling this at all, so the window gives way
 * instead - the class selector keeps it off message boxes, which must stay
 * the size of their text. */

DlgPreferences {
  min-width: 1400px;
}

/* The preferences navigation. Mixxx sizes this column from the text it holds,
 * measured before the style sheet has widened the font, so every second entry
 * ends in an ellipsis. The longest label decides the floor. */
QDialog QTreeView#contentsTreeWidget {
  min-width: 15em;
  border: 0px;
  border-right: 1px solid #333333;
}

QDialog QHeaderView::section {
  background-color: #1a1a1a;
  color: @dim@;
  border: 0px;
  border-bottom: 1px solid #333333;
  border-right: 1px solid #333333;
  padding: 3px;
}

/* --- Tabs ----------------------------------------------------------------- */

QDialog QTabWidget::pane {
  border: 1px solid #333333;
  border-radius: 0px;
  top: -1px;
}
QDialog QTabBar::tab {
  background-color: #1a1a1a;
  color: @dim@;
  border: 1px solid #333333;
  border-bottom: 0px;
  border-radius: 0px;
  padding: 4px 12px;
  margin-right: 1px;
}
  QDialog QTabBar::tab:selected {
    background-color: @bg@;
    color: @fg@;
    border-bottom: 1px solid @bg@;
  }
  QDialog QTabBar::tab:hover:!selected {
    color: @fg@;
  }

/* --- Scroll bars ---------------------------------------------------------
 * Same shape the library scroll bars have: no arrows, no groove decoration,
 * a plain handle on the page background. */

QDialog QScrollBar:vertical {
  background-color: @bg@;
  width: 10px;
  margin: 0px;
  border: 0px;
}
QDialog QScrollBar:horizontal {
  background-color: @bg@;
  height: 10px;
  margin: 0px;
  border: 0px;
}
  QDialog QScrollBar::handle:vertical,
  QDialog QScrollBar::handle:horizontal {
    background-color: #3a3a3a;
    border-radius: 0px;
    min-height: 24px;
    min-width: 24px;
  }
  QDialog QScrollBar::handle:hover {
    background-color: @border@;
  }
  QDialog QScrollBar::add-line,
  QDialog QScrollBar::sub-line {
    height: 0px;
    width: 0px;
    border: 0px;
    background: transparent;
  }
  QDialog QScrollBar::add-page,
  QDialog QScrollBar::sub-page {
    background: transparent;
  }

QDialog QScrollArea {
  border: 0px;
}

/* --- Sliders -------------------------------------------------------------- */

QDialog QSlider::groove:horizontal {
  background-color: #2a2a2a;
  height: 3px;
  border: 0px;
}
QDialog QSlider::groove:vertical {
  background-color: #2a2a2a;
  width: 3px;
  border: 0px;
}
  QDialog QSlider::handle:horizontal {
    background-color: @accent@;
    width: 9px;
    margin: -6px 0px;
    border-radius: 0px;
  }
  QDialog QSlider::handle:vertical {
    background-color: @accent@;
    height: 9px;
    margin: 0px -6px;
    border-radius: 0px;
  }
  QDialog QSlider::sub-page:horizontal {
    background-color: #3a4e46;
  }

/* --- Progress ------------------------------------------------------------- */

QDialog QProgressBar {
  background-color: #1a1a1a;
  border: 1px solid #333333;
  border-radius: 0px;
  text-align: center;
  color: @fg@;
}
  QDialog QProgressBar::chunk {
    background-color: @accent@;
  }

/* --- Menus and tooltips --------------------------------------------------
 * Top-level windows again, so they are not reachable through `QDialog` and
 * are addressed by class. Both belong to the whole application anyway - the
 * skin styles the main window's own menus separately and, sitting closer to
 * those widgets, keeps winning. */

QMenu {
  background-color: @bg@;
  color: @fg@;
  border: 1px solid @border@;
  padding: 2px;
}
  QMenu::item {
    padding: 3px 20px 3px 20px;
  }
  QMenu::item:selected {
    background-color: @surface@;
  }
  QMenu::item:disabled {
    color: #666666;
  }
  QMenu::separator {
    height: 1px;
    background-color: #333333;
    margin: 3px 6px;
  }

QToolTip {
  background-color: @surface@;
  color: @fg@;
  border: 1px solid @border@;
  padding: 3px;
}
